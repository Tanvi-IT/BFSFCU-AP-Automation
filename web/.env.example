# Copy to .env and fill in. Vite inlines VITE_* at BUILD time.
# These are public values (client id / tenant id are not secrets) — but there
# must never be an API key or client secret in this file.

VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Scope exposed by the API app registration, e.g. api://<api-client-id>/access_as_user
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Left as /api in development so Vite proxies to the Functions host on :7071.
VITE_API_BASE_URL=/api

# Demo mode: shows the "Reset Demo Data" control in the sidebar. Leave unset in production.
VITE_DEMO_MODE=false
