{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AZURE_FUNCTIONS_ENVIRONMENT": "Development",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",

    "//SESSION_SECRET": "Strong random value used to sign session tokens. Use Key Vault in production.",
    "SESSION_SECRET": "<a-strong-random-secret>",
    "SESSION_TTL": "12h",
    "//SETTINGS_ENC_KEY": "Key for encrypting secrets stored in the DB (the Prologue SQL password, configured via the admin UI). Falls back to SESSION_SECRET if unset. Set a dedicated value in production and do NOT rotate it without re-saving the settings.",
    "SETTINGS_ENC_KEY": "",
    "//AUTH_COOKIE_INSECURE": "true only for local HTTP; omit in Azure so the cookie is Secure.",
    "AUTH_COOKIE_INSECURE": "true",

    "PG_HOST": "localhost",
    "PG_PORT": "5432",
    "PG_DATABASE": "bfsfcu_ap",
    "PG_USER": "postgres",
    "PG_PASSWORD": "postgres",
    "PG_SSL": "false",
    "PG_USE_MANAGED_IDENTITY": "false",

    "BLOB_ACCOUNT_URL": "http://127.0.0.1:10000/devstoreaccount1",
    "BLOB_CONTAINER": "invoices",
    "QUEUE_ACCOUNT_URL": "http://127.0.0.1:10001/devstoreaccount1",
    "QUEUE_NAME": "invoice-jobs",

    "DOCINTEL_ENDPOINT": "https://<your-docintel>.cognitiveservices.azure.com",
    "DOCINTEL_KEY": "<docintel-key-for-local-dev-only>",
    "AOAI_ENDPOINT": "https://<your-openai>.openai.azure.com",
    "AOAI_KEY": "<openai-key-for-local-dev-only>",
    "AOAI_DEPLOYMENT": "gpt-4o",
    "AOAI_API_VERSION": "2024-08-01-preview",
    "//AOAI_REASONING_MODEL": "true for gpt-5.x / o-series deployments, false for gpt-4o-style",
    "AOAI_REASONING_MODEL": "false",

    "//PROLOGUE": "Fiserv Prologue (SQL Server) integration. Inert unless PROLOGUE_ENABLED=true. Put PROLOGUE_PASSWORD in Key Vault / Function App settings, never in a committed file.",
    "PROLOGUE_ENABLED": "false",
    "PROLOGUE_HOST": "<prologue-sql-server-host>",
    "PROLOGUE_PORT": "1433",
    "PROLOGUE_DATABASE": "<prologue-db-name>",
    "PROLOGUE_USER": "<sql-login-with-execute-on-the-two-procs-only>",
    "PROLOGUE_PASSWORD": "<sql-login-password>",
    "//PROLOGUE_ENCRYPT": "true for TLS to SQL Server; set PROLOGUE_TRUST_SERVER_CERT=true only for a self-signed cert on a trusted network",
    "PROLOGUE_ENCRYPT": "true",
    "PROLOGUE_TRUST_SERVER_CERT": "false",
    "//PROLOGUE_DEFAULTS": "company_id and default GL account observed in BankFund sample data; confirm before go-live",
    "PROLOGUE_COMPANY_ID": "01",
    "PROLOGUE_DEFAULT_ACCOUNT": "01886910800005",
    "PROLOGUE_SOURCE_USER": "TANVI",

    "ALLOWED_ORIGINS": "http://localhost:8080",
    "LOG_LEVEL": "info"
  },
  "Host": {
    "CORS": "http://localhost:8080",
    "CORSCredentials": false
  }
}
